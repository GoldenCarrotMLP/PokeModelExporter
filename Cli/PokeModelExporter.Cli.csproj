<Project Sdk="Microsoft.NET.Sdk">

  <!-- Command-line front end. Compiles the library in ../Runtime directly (the same sources Unity
       uses as a package). LangVersion 9 keeps the library compatible with Unity 6. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>pokemodelexporter</AssemblyName>
    <RootNamespace>PokeModelExporter.Cli</RootNamespace>
    <NoWarn>CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Runtime/**/*.cs" Link="Runtime/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
